# ==============================================================================
# LUNARIS Urban Intelligence Platform — Environment Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Populate the required values below.
# 3. NEVER commit your actual .env file to Git / Version Control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Configuration (Browser / Client-Side)
# ------------------------------------------------------------------------------
# Public Supabase URL & Publishable Anon Key (Safe for client browsers)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_anon_key_here

# ------------------------------------------------------------------------------
# 2. Backend Central API (FastAPI / Node Web Server)
# ------------------------------------------------------------------------------
# Server port configuration
PORT=8080

# Supabase Server-Side URL & Secret Service Key (STRICTLY BACKEND ONLY — NEVER EXPOSE TO CLIENT)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_service_role_key_here

# ------------------------------------------------------------------------------
# 3. AI Service Pipeline (YOLOv8 Edge Inference Service)
# ------------------------------------------------------------------------------
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_service_role_key_here

# ------------------------------------------------------------------------------
# 4. Optional Integrations (100% Optional — Not Required for Core Platform)
# ------------------------------------------------------------------------------
# Resend Email API Key (Backend-only. If empty, internal notifications still work)
RESEND_API_KEY=

# Optional Mapbox Token (Optional only. LUNARIS natively uses free Leaflet + OpenStreetMap)
MAPBOX_ACCESS_TOKEN=

# MediaMTX WebRTC & RTSP Stream Gateway Endpoints
MEDIAMTX_RTSP_URL=rtsp://localhost:8554
MEDIAMTX_WEBRTC_URL=http://localhost:8889
